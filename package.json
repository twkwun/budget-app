{
  "name": "budget-app",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @budget/server --filter @budget/web dev",
    "build": "pnpm --filter @budget/shared build && pnpm --filter @budget/server --filter @budget/web build",
    "start": "pnpm --filter @budget/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r test",
    "backup": "pnpm --filter @budget/server backup",
    "db:generate": "pnpm --filter @budget/server db:generate",
    "e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "e2e:only": "playwright test --config e2e/playwright.config.ts",
    "manual:shots": "node e2e/manual-shots.ts",
    "manual:md": "node apps/web/scripts/manual-md.ts",
    "seed:demo": "pnpm --filter @budget/server seed:demo",
    "reprocess": "pnpm --filter @budget/server reprocess"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
