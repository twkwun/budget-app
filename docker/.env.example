# Copy to .env next to compose.yml and fill in. Never commit the real .env.
# Values below are placeholders.

# --- Tailscale sidecar ---
# Auth key from https://login.tailscale.com/admin/settings/keys
# (reusable not needed; tag it if you use ACL tags). Only used on first start;
# the node identity is then kept in TAILSCALE_STATE_DIR.
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Machine name in the tailnet -> https://<TS_HOSTNAME>.<tailnet>.ts.net
# Passkeys are bound to this address: choose once and do not change it.
TS_HOSTNAME=budget
# Optional extra `tailscale up` flags, e.g. --advertise-tags=tag:budget
TS_EXTRA_ARGS=
# Where the Tailscale node state is stored on the NAS.
TAILSCALE_STATE_DIR=./tailscale/state
# Tailscale image tag (stable or a pinned version such as v1.90.0).
TAILSCALE_IMAGE_TAG=stable

# --- App image ---
# ghcr.io/<github owner>/<repo>, lowercase.
APP_IMAGE=ghcr.io/twkwun/budget-app
# `latest` = newest release tag, `main` = latest commit on main, or a version like 0.1.0.
APP_TAG=latest
# uid:gid the app runs as; must be able to write DATA_PATH (`id` on the NAS shows yours).
APP_UID=1000
APP_GID=1000

# --- App ---
# Folder on the NAS holding budget.sqlite and backups/ (include it in Hyper Backup).
DATA_PATH=./data
# Signs login sessions. At least 32 characters: `openssl rand -base64 48`.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
# The exact HTTPS address the family opens (origin only, no path).
PUBLIC_ORIGIN=https://budget.your-tailnet.ts.net
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Daily SQLite backup into DATA_PATH/backups.
BACKUP_ENABLED=true
# Local time in Asia/Seoul, HH:MM (24h).
BACKUP_TIME=04:00
# Backups older than this many days are deleted (the newest is always kept).
BACKUP_RETENTION_DAYS=30

# --- Set by the image; normally leave unset ---
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# DATA_DIR=/data
# WEB_DIST_DIR=/app/public
# APP_VERSION / APP_COMMIT are baked in at image build time and shown by /api/health.
