{
  "name": "@budget/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Budget app API server",
  "files": [
    "dist",
    "drizzle"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --conditions=@budget/source --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backup": "node --conditions=@budget/source --env-file-if-exists=.env src/cli/backup.ts",
    "db:generate": "drizzle-kit generate",
    "seed:demo": "node --conditions=@budget/source --env-file-if-exists=.env src/cli/seed-demo.ts",
    "reprocess": "node --conditions=@budget/source --env-file-if-exists=.env src/cli/reprocess.ts"
  },
  "dependencies": {
    "@budget/shared": "workspace:*",
    "@fastify/static": "^10.1.12",
    "@simplewebauthn/server": "^14.1.0",
    "better-sqlite3": "^13.2.0",
    "cfb": "^1.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.1"
  }
}
